// Copy to Config.xcconfig and fill in local development values.
// Config.xcconfig is intentionally ignored by git.

SUPABASE_URL = https://your-project.supabase.co
SUPABASE_ANON_KEY = your-supabase-anon-key
GOOGLE_MAPS_API_KEY = your-ios-restricted-google-maps-platform-api-key
GEMINI_API_KEY = your-google-gemini-api-key
GEMINI_MODEL = gemini-2.5-flash
